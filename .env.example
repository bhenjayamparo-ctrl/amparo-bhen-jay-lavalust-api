# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=
# Optional / deployment
# Set to production on Render (hides the dangerous migration routes)
# APP_ENV=production
# Aiven requires SSL: set DB_SSL=true (and optionally DB_SSL_CA=/path/to/ca.pem)
DB_SSL=
DB_SSL_CA=
# Allowed frontend origin(s), comma separated. Leave empty for local dev (allows any).
CORS_ORIGIN=
